# Copy this file to .env and fill in your credentials
# cp .env.example .env

# Required — IBM Cloud API key (cloud.ibm.com → Manage → IAM → API keys)
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here

# Required — watsonx.ai Project ID (dataplatform.cloud.ibm.com → Projects → Manage → General)
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Required — watsonx.ai region URL (choose your region)
# Dallas:   https://us-south.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
# London:   https://eu-gb.ml.cloud.ibm.com
# Tokyo:    https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
